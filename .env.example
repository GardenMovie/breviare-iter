VITE_API_URL=your_api_url_here
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Short-link domain used to build /u/<username> vanity URLs.
# Optional — defaults to the current origin, which is correct when the
# frontend is served from the same host as the short links.
VITE_BASE_URL=

# Set to "true" to serve the under-construction page instead of the app.
VITE_UNDER_CONSTRUCTION=false
